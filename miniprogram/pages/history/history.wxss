/* pages/history/history.wxss - 报告历史页 */
.page { position: relative; min-height: 100vh; overflow: hidden; }
.bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0;
      background: linear-gradient(135deg, #1a1a2e 0%, #2d1b4e 50%, #16213e 100%); }
.content { position: relative; z-index: 1; min-height: 100vh;
          padding: 60rpx 40rpx; display: flex; flex-direction: column; align-items: center; }

/* 头部 */
.header { width: 100%; margin-bottom: 40rpx; }
.title { color: #fff; font-size: 56rpx; font-weight: bold; text-align: center; }
.subtitle { color: #778ca3; font-size: 24rpx; text-align: center; margin-top: 8rpx; }

/* 状态：加载/空/错误 */
.state { padding: 120rpx 0; text-align: center; display: flex; flex-direction: column; align-items: center; }
.state-text { color: #a5b1c2; font-size: 32rpx; margin-bottom: 12rpx; }
.state-tip { color: #778ca3; font-size: 24rpx; margin-bottom: 32rpx; }
.spinner { width: 80rpx; height: 80rpx; border: 6rpx solid rgba(255,255,255,0.1);
           border-top-color: #a29bfe; border-radius: 50%;
           animation: spin 0.8s linear infinite; margin-bottom: 24rpx; }
@keyframes spin { to { transform: rotate(360deg); } }
.empty-icon { font-size: 80rpx; margin-bottom: 24rpx; }

/* 列表 */
.list { width: 100%; display: flex; flex-direction: column; gap: 24rpx; }
.card { position: relative; width: 100%; background: rgba(255,255,255,0.06);
        border: 2rpx solid rgba(255,255,255,0.1); border-radius: 24rpx;
        padding: 32rpx; box-sizing: border-box; }
.card-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16rpx; }
.type-name { color: #a29bfe; font-size: 36rpx; font-weight: bold; }
.time { color: #778ca3; font-size: 24rpx; }
.summary { color: #e8e8f0; font-size: 28rpx; line-height: 1.5; }
.summary.fallback { color: #778ca3; font-style: italic; }
.arrow { position: absolute; right: 32rpx; top: 50%; transform: translateY(-50%);
         color: #778ca3; font-size: 48rpx; }

/* 按钮 */
.btn-cta { background: linear-gradient(90deg, #6c5ce7, #a29bfe); color: #fff;
           border-radius: 48rpx; height: 96rpx; padding: 0 48rpx;
           display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.btn-cta::after { border: none; }
.btn-retry { background: rgba(255,255,255,0.08); color: #a29bfe;
             border: 2rpx solid rgba(162,155,254,0.3); border-radius: 48rpx;
             height: 96rpx; padding: 0 48rpx;
             display: flex; align-items: center; justify-content: center; font-size: 30rpx; }
.btn-retry::after { border: none; }

.footer-tip { color: #778ca3; font-size: 24rpx; text-align: center; margin-top: 24rpx; }
