/* pages/share/share.wxss - 海报页 */
.page { position: relative; min-height: 100vh; overflow: hidden; }
.bg { position: absolute; top: 0; left: 0; right: 0; bottom: 0;
      background: linear-gradient(135deg, #1a1a2e 0%, #2d1b4e 50%, #16213e 100%); }
.content { position: relative; z-index: 1; min-height: 100vh;
          padding: 60rpx 40rpx; display: flex; flex-direction: column; align-items: center; }

/* 离屏 canvas */
.offscreen { position: absolute; left: -9999px; top: 0; width: 750px; height: 1000px; }

/* 标题 */
.title { color: #a29bfe; font-size: 36rpx; margin-bottom: 48rpx; }

/* 海报展示 */
.poster-wrap { width: 100%; display: flex; flex-direction: column; align-items: center; margin-bottom: 32rpx; }
.poster-img { width: 100%; max-width: 600rpx; border-radius: 16rpx;
              box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.4); }
.hint { color: #778ca3; font-size: 24rpx; margin-top: 16rpx; }

/* 加载中 */
.loading { padding: 80rpx 0; display: flex; flex-direction: column; align-items: center; }
.spinner { width: 80rpx; height: 80rpx; border: 6rpx solid rgba(255,255,255,0.1);
           border-top-color: #a29bfe; border-radius: 50%;
           animation: spin 0.8s linear infinite; margin-bottom: 24rpx; }
.loading-text { color: #a5b1c2; font-size: 28rpx; }
@keyframes spin { to { transform: rotate(360deg); } }

/* 错误 */
.error-wrap { padding: 80rpx 0; text-align: center; }
.error-text { color: #fff; font-size: 32rpx; margin-bottom: 12rpx; }
.error-tip { color: #778ca3; font-size: 24rpx; }

/* 按钮 */
.btn-save { width: 100%; margin-top: 16rpx; background: linear-gradient(90deg, #6c5ce7, #a29bfe);
            color: #fff; border-radius: 48rpx; height: 96rpx;
            display: flex; align-items: center; justify-content: center; font-size: 30rpx; padding: 0 32rpx; box-sizing: border-box; }
.btn-save::after { border: none; }
.btn-back { width: 100%; margin-top: 24rpx; background: rgba(255,255,255,0.08);
            color: #a29bfe; border: 2rpx solid rgba(162,155,254,0.3); border-radius: 48rpx;
            height: 96rpx; display: flex; align-items: center; justify-content: center; font-size: 30rpx; padding: 0 32rpx; box-sizing: border-box; }
.btn-back::after { border: none; }
