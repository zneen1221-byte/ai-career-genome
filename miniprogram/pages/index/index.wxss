/* pages/index/index.wxss - 首页 */
.page { position: relative; min-height: 100vh; overflow: hidden; }
.bg {
  position: absolute; top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #1a1a2e 0%, #2d1b4e 50%, #16213e 100%);
}
.content {
  position: relative; z-index: 1;
  min-height: 100vh;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  padding: 60rpx;
}
.logo { font-size: 120rpx; margin-bottom: 40rpx; }
.slogan { font-size: 32rpx; color: #a5b1c2; margin-bottom: 24rpx; }
.title { font-size: 56rpx; font-weight: bold; color: #fff; text-align: center; margin-bottom: 24rpx; line-height: 1.4; }
.meta { font-size: 26rpx; color: #778ca3; margin-bottom: 80rpx; }
.cta {
  width: 80%; max-width: 560rpx; height: 96rpx;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(90deg, #6c5ce7, #a29bfe);
  color: #fff; border-radius: 48rpx; font-size: 32rpx; font-weight: 600; border: none;
  padding: 0; box-sizing: border-box;
}
.cta::after { border: none; }
.social { font-size: 24rpx; color: #576574; margin-top: 60rpx; }
.privacy-link { font-size: 24rpx; color: #778ca3; margin-top: 20rpx; text-decoration: underline; }
